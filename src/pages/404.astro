---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在，或者已经被移除。" canonical={false}>
  <section class="not-found shell" aria-labelledby="not-found-title">
    <div class="not-found-content">
      <p class="error-code">404</p>
      <h1 id="not-found-title">页面未找到</h1>
      <p class="message">你访问的页面不存在，或者已经被移除。</p>
      <a class="home-link" href="/">返回首页 <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: calc(100svh - 172px);
    padding-block: 64px;
  }

  .not-found-content {
    width: min(100%, 640px);
    padding-top: 24px;
    border-top: 2px solid var(--accent);
  }

  .error-code {
    margin: 0 0 22px;
    color: var(--accent-text);
    font-size: clamp(72px, 12vw, 112px);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -.06em;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.2;
    letter-spacing: -.025em;
  }

  .message {
    margin: 16px 0 32px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 10px 18px;
    color: var(--accent-text);
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 13px;
    font-weight: 700;
    transition: background .18s ease, border-color .18s ease;
  }

  .home-link:hover {
    background: var(--surface-hover);
    border-color: var(--accent);
  }
</style>
