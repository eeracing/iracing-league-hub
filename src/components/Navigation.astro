---
import { config } from '../../config/site';
import { getSeriesConfigs } from '../lib/data';
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell nav-inner">
    <a class="brand" href="/" aria-label={`${config.site.name} 首页`}>
      <img src={config.site.logo} alt="" width="36" height="36" />
      <span>{config.site.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="赛事导航">
      <a class:list={[{ active: pathname === '/' }]} aria-current={pathname === '/' ? 'page' : undefined} href="/">总览</a>
      {getSeriesConfigs().map((series) => (
        <a class:list={[{ active: pathname.startsWith(`/racing/${series.slug}`) }]} aria-current={pathname.startsWith(`/racing/${series.slug}`) ? 'page' : undefined} href={`/racing/${series.slug}`}>
          {series.shortName || series.name}
        </a>
      ))}
    </nav>
    <details class="mobile-nav">
      <summary>
        <span class="mobile-nav__open">菜单</span>
        <span class="mobile-nav__close">关闭</span>
        <span class="mobile-nav__mark" aria-hidden="true"></span>
      </summary>
      <div class="mobile-nav__panel">
        <nav aria-label="手机端赛事导航">
          <a class:list={[{ active: pathname === '/' }]} aria-current={pathname === '/' ? 'page' : undefined} href="/">总览</a>
          {getSeriesConfigs().map((series) => (
            <a class:list={[{ active: pathname.startsWith(`/racing/${series.slug}`) }]} aria-current={pathname.startsWith(`/racing/${series.slug}`) ? 'page' : undefined} href={`/racing/${series.slug}`}>
              {series.shortName || series.name}
            </a>
          ))}
        </nav>
      </div>
    </details>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换主题" title="切换主题" aria-pressed="false">
      <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" /></svg>
      <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
    </button>
  </div>
</header>
<script is:inline>
  const mobileNav = document.querySelector('.mobile-nav');
  document.addEventListener('click', (event) => {
    if (mobileNav?.open && !mobileNav.contains(event.target)) mobileNav.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNav?.open) {
      mobileNav.open = false;
      mobileNav.querySelector('summary')?.focus();
    }
  });
</script>
