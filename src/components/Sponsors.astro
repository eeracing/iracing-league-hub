---
import { sponsors } from '../../config/sponsors';
import SectionHeading from './SectionHeading.astro';

const visibleSponsors = [...sponsors].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
---

{visibleSponsors.length > 0 && <section class="content-section compact-section section-muted sponsors-section">
  <div class="shell">
    <SectionHeading title="合作伙伴" />
    <div class="sponsors-grid">
      {visibleSponsors.map((sponsor) => sponsor.url ?
        <a class="sponsor-card" href={sponsor.url} target="_blank" rel="noopener noreferrer" aria-label={`访问 ${sponsor.name} 网站（在新窗口打开）`}>
          <span class="sponsor-logo"><img src={sponsor.logo} alt={sponsor.name} width="240" height="100" loading="lazy" /></span>
          <span class="sponsor-name">{sponsor.name}<span aria-hidden="true">↗</span></span>
        </a> :
        <div class="sponsor-card">
          <span class="sponsor-logo"><img src={sponsor.logo} alt={sponsor.name} width="240" height="100" loading="lazy" /></span>
          <span class="sponsor-name">{sponsor.name}</span>
        </div>
      )}
    </div>
  </div>
</section>}
