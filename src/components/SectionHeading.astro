---
interface Props { as?: 'h1' | 'h2'; eyebrow?: string; title: string; link?: string; linkLabel?: string }
const { as: HeadingTag = 'h2', eyebrow, title, link, linkLabel = '查看全部' } = Astro.props;
---
<header class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <HeadingTag>{title}</HeadingTag>
  </div>
  {link && <a class="text-link" href={link}>{linkLabel} <span aria-hidden="true">→</span></a>}
</header>
